              <pre class="bg-slate-950 p-3 rounded text-xs text-emerald-400 overflow-x-auto"><code id="code-gab5-1">CREATE TABLE auditoria_pedidos (
    id_auditoria NUMBER GENERATED ALWAYS AS IDENTITY,
