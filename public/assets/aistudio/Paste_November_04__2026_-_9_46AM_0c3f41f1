  <!-- Notificação Flutuante de Cópia -->
  <div id="toast" class="fixed bottom-6 right-6 bg-emerald-600 text-white text-xs px-4 py-2.5 rounded-lg shadow-xl opacity-0 pointer-events-none transition-all duration-300">
    Código copiado com sucesso!
