            <pre class="bg-slate-950 p-3 rounded text-xs text-emerald-400 overflow-x-auto"><code id="code-gab4">-- Tabela de Logs
CREATE TABLE log_processamento (
    id_log NUMBER GENERATED ALWAYS AS IDENTITY,
    mensagem VARCHAR2(100),
    data_log DATE
);

-- Bloco com laço FOR
BEGIN
    FOR i IN 1..5 LOOP
        INSERT INTO log_processamento (mensagem, data_log)
        VALUES ('Processamento do item ' || i, SYSDATE);
    END LOOP;
    COMMIT;
END;
/

-- Function
CREATE OR REPLACE FUNCTION fn_valida_cliente_ativo(p_id_cliente IN NUMBER) 
RETURN VARCHAR2 
IS
    v_status clientes.status%TYPE;
BEGIN
    SELECT status INTO v_status FROM clientes WHERE id_cliente = p_id_cliente;
    
    IF v_status = 'ATIVO' THEN
        RETURN 'S';
    ELSE
        RETURN 'N';
    END IF;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN 'INEXISTENTE';
END;
/

-- Teste no SELECT:
SELECT id_cliente, nome, fn_valida_cliente_ativo(id_cliente) AS is_ativo FROM clientes;</code></pre>
