    acao VARCHAR2(20),
    data_hora DATE,
    usuario VARCHAR2(50)
);

CREATE OR REPLACE TRIGGER trg_pedidos_audit
AFTER INSERT OR UPDATE OR DELETE ON pedidos
FOR EACH ROW
DECLARE
    v_acao VARCHAR2(20);
BEGIN
    IF INSERTING THEN
        v_acao := 'INSERCAO';
        INSERT INTO auditoria_pedidos (id_pedido, acao, data_hora, usuario)
        VALUES (:NEW.id_pedido, v_acao, SYSDATE, USER);
    ELSIF UPDATING THEN
        v_acao := 'ALTERACAO';
        INSERT INTO auditoria_pedidos (id_pedido, acao, data_hora, usuario)
        VALUES (:NEW.id_pedido, v_acao, SYSDATE, USER);
    ELSIF DELETING THEN
        v_acao := 'EXCLUSAO';
        INSERT INTO auditoria_pedidos (id_pedido, acao, data_hora, usuario)
        VALUES (:OLD.id_pedido, v_acao, SYSDATE, USER);
    END IF;
END;
